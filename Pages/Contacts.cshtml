@page
@model ContactsModel
@{
    ViewData["Title"] = "Контакты";
}

<div class="container py-5">
    <h1 class="text-center mb-5">Свяжитесь с нами</h1>

    <div class="row">
        <div class="col-lg-5 mb-4 mb-lg-0">
            <div class="card border-0 shadow-lg h-100">
                <div class="card-body p-4">
                    <h3 class="card-title mb-4">Контактная информация</h3>

                    <div class="contact-info mb-4">
                        <div class="d-flex align-items-start mb-3">
                            <i class="fas fa-map-marker-alt text-primary fa-lg me-3 mt-1"></i>
                            <div>
                                <h5>Адрес</h5>
                                <p class="text-muted">Московская область, Коломна, проезд Станкостроителей, 5А</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start mb-3">
                            <i class="fas fa-phone text-primary fa-lg me-3 mt-1"></i>
                            <div>
                                <h5>Телефон</h5>
                                <p class="text-muted">+7 (930) 334-86-65</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start mb-3">
                            <i class="fas fa-envelope text-primary fa-lg me-3 mt-1"></i>
                            <div>
                                <h5>Email</h5>
                                <p class="text-muted">topstudent018@example.com</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start">
                            <i class="fas fa-clock text-primary fa-lg me-3 mt-1"></i>
                            <div>
                                <h5>Часы работы</h5>
                                <p class="text-muted mb-1">Пн-Вс: 9:00 - 20:00</p>
                            </div>
                        </div>
                    </div>

                    <div class="map-container mb-4">
                        <div id="map" style="height: 250px; background-color: #e9ecef; border-radius: 8px;" class="d-flex align-items-center justify-content-center">
                            <script type="text/javascript" charset="utf-8" async src="https://api-maps.yandex.ru/services/constructor/1.0/js/?um=constructor%3A9f0637209dc88be4bd217493b31467f4f25920c9f00c2600d2e2937fa108c199&amp;width=500&amp;height=250&amp;lang=ru_RU&amp;scroll=true"></script>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-4">
                    <h3 class="card-title mb-4">Задайте вопрос нейросети</h3>

                    <form method="post">
                        <div class="row">
                            <div class="mb-3">
                                <label asp-for="AIChatForm.Name" class="form-label">Имя (необязательно)</label>
                                <input asp-for="AIChatForm.Name" class="form-control">
                                <span asp-validation-for="AIChatForm.Name" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="AIChatForm.AIQuestion" class="form-label">Ваш вопрос *</label>
                            <textarea asp-for="AIChatForm.AIQuestion" class="form-control" rows="6"
                                      placeholder="пример вашего вопроса для нейросети: Машина плохо заводится утром, двигатель дымит белым дымом, пробег около 80 тыс. км, марка/модель: Toyota Camry V6." required></textarea>
                            <span asp-validation-for="AIChatForm.AIQuestion" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="AIChatForm.AgreeToTerms" class="form-check-input" required>
                            <label asp-for="AIChatForm.AgreeToTerms" class="form-check-label">
                                Я принимаю условия использования нейросети
                            </label>
                            <span asp-validation-for="AIChatForm.AgreeToTerms" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fas fa-robot me-2"></i>Задать вопрос нейросети
                        </button>
                    </form>

                    @if (Model.ShowAIResponse)
                    {
                        <div class="alert alert-info mt-4" role="alert">
                            <i class="fas fa-brain me-2"></i>
                            <strong>Ответ нейросети:</strong>
                            <p class="mb-0 mt-2">@Model.AIResponseText</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}