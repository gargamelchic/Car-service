@page
@model ContactsModel
@{
    ViewData["Title"] = "Контакты";
}

<div class="container py-5">
    <h1 class="text-center mb-5">Свяжитесь с нами</h1>

    <div class="row">
        <div class="col-lg-5 mb-4 mb-lg-0">
            <div class="card border-0 shadow-lg h-100">
                <div class="card-body p-4">
                    <h3 class="card-title mb-4">Контактная информация</h3>

                    <div class="contact-info mb-4">
                        <div class="d-flex align-items-start mb-3">
                            <i class="fas fa-map-marker-alt text-primary fa-lg me-3 mt-1"></i>
                            <div>
                                <h5>Адрес</h5>
                                <p class="text-muted">г. Коломна, ул. Колотушкина, д. 123</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start mb-3">
                            <i class="fas fa-phone text-primary fa-lg me-3 mt-1"></i>
                            <div>
                                <h5>Телефон</h5>
                                <p class="text-muted">+7 (930) 334-86-65</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start mb-3">
                            <i class="fas fa-envelope text-primary fa-lg me-3 mt-1"></i>
                            <div>
                                <h5>Email</h5>
                                <p class="text-muted">topstudent018@example.com</p>
                            </div>
                        </div>

                        <div class="d-flex align-items-start">
                            <i class="fas fa-clock text-primary fa-lg me-3 mt-1"></i>
                            <div>
                                <h5>Часы работы</h5>
                                <p class="text-muted mb-1">Ежедневно: 9:00 - 20:00</p>
                            </div>
                        </div>
                    </div>

                    <div class="map-container mb-4">
                        <div id="map" style="height: 250px; background-color: #e9ecef; border-radius: 8px;" class="d-flex align-items-center justify-content-center">
                            <a href="https://yandex.ru/maps/?um=constructor%3A361d99502bb8715efdd2f416d860808e6180cf886a4f7149e4e8a3b277d09980&amp;source=constructorStatic" target="_blank"><img src="https://api-maps.yandex.ru/services/constructor/1.0/static/?um=constructor%3A361d99502bb8715efdd2f416d860808e6180cf886a4f7149e4e8a3b277d09980&amp;width=450&amp;height=250&amp;lang=ru_RU" alt="" style="border: 0;" /></a>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card border-0 shadow-lg">
                <div class="card-body p-4">
                    <h3 class="card-title mb-4">Форма обратной связи</h3>

                    <form method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ContactForm.Name" class="form-label">Имя *</label>
                                <input asp-for="ContactForm.Name" class="form-control" required>
                                <span asp-validation-for="ContactForm.Name" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="ContactForm.Email" class="form-label">Email *</label>
                                <input asp-for="ContactForm.Email" type="email" class="form-control" required>
                                <span asp-validation-for="ContactForm.Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ContactForm.Phone" class="form-label">Телефон</label>
                            <input asp-for="ContactForm.Phone" class="form-control">
                            <span asp-validation-for="ContactForm.Phone" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ContactForm.Subject" class="form-label">Тема *</label>
                            <select asp-for="ContactForm.Subject" class="form-select" required>
                                <option value="">Выберите тему</option>
                                <option value="general">Общий вопрос</option>
                                <option value="services">Информация об услугах</option>
                                <option value="appointment">Запись на консультацию</option>
                                <option value="cooperation">Сотрудничество</option>
                                <option value="other">Другое</option>
                            </select>
                            <span asp-validation-for="ContactForm.Subject" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ContactForm.Message" class="form-label">Сообщение *</label>
                            <textarea asp-for="ContactForm.Message" class="form-control" rows="5" required></textarea>
                            <span asp-validation-for="ContactForm.Message" class="text-danger"></span>
                        </div>

                        <div class="form-check mb-4">
                            <input asp-for="ContactForm.AgreeToPrivacy" class="form-check-input" required>
                            <label asp-for="ContactForm.AgreeToPrivacy" class="form-check-label">
                                Я согласен на обработку персональных данных
                            </label>
                            <span asp-validation-for="ContactForm.AgreeToPrivacy" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary btn-lg w-100">
                            <i class="fas fa-paper-plane me-2"></i>Отправить сообщение
                        </button>
                    </form>

                    @if (Model.ShowSuccessMessage)
                    {
                            <div class="alert alert-success mt-4" role="alert">
                                <i class="fas fa-check-circle me-2"></i>Спасибо! Ваше сообщение отправлено. Мы свяжемся с вами в ближайшее время.
                            </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
        <partial name="_ValidationScriptsPartial" />
}